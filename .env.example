# Copy to .env and fill in. Everything prefixed EXPO_PUBLIC_ is baked into the app
# (it is NOT secret). Never put service-role keys or FCM credentials here.
# Full walkthrough: docs/SETUP.md

# --- Supabase -------------------------------------------------------------------
# Hosted (Supabase dashboard → Project Settings → API): https://<ref>.supabase.co
# Local stack (`npm run db:start`): http://127.0.0.1:55321
#   For an emulator or USB phone, first run: adb reverse tcp:55321 tcp:55321
EXPO_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe to ship in the app; RLS protects the data).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Sign-In ---------------------------------------------------------------
# The *Web* OAuth client ID (Google Cloud → APIs & Services → Credentials). Also add
# it to Supabase → Authentication → Providers → Google → Client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional, iOS only (later): iOS client ID and its reversed form for the URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

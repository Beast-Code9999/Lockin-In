    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "sharp": "^0.35.5",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
